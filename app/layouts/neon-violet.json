  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "neon-violet",
  "window_blur": true,
  "terminal_opacity": 0.82,
  "colors": {
    "background": "#130a1f99",
    "canvas": "#0f081900",
    "chrome": "#1a0e2c80",
    "surface": "#1a0e2c99",
    "border": "#5e4a8066"
  }
