            {
              "id": "nv-play-list",
              "type": "block",
              "content": {
                "mod": "nv-sidebar",
                "props": {
                  "section": "play"
                }
              },
              "size": {
                "weight": 0.6
              },
              "min": 62
            },
            {
              "id": "nv-pipeline-list",
              "type": "block",
              "content": {
                "mod": "nv-sidebar",
